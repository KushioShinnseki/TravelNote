.page{min-height:100vh;background:#f7f5f0;color:#102d34;padding-bottom:44rpx}.hero{background:#102d34;color:#f8f4e9;padding:54rpx 38rpx 42rpx;border-radius:0 0 34rpx 34rpx}.brand{display:flex;align-items:center;font-size:34rpx;font-weight:800}.brand-dot{width:25rpx;height:25rpx;border:7rpx solid #ee735f;border-radius:50%;margin-right:16rpx}.hero-title{display:block;font-size:46rpx;font-weight:800;margin-top:52rpx}.hero-subtitle{display:block;color:#adc0bb;font-size:25rpx;margin-top:13rpx}.scan-button{margin:34rpx 0 0;background:#ee735f;color:white;border-radius:12rpx;font-size:28rpx;font-weight:700}.account-card{margin:24rpx 28rpx 0;padding:25rpx;background:#fffdf9;border:1rpx solid #e5e5df;border-radius:18rpx;display:flex;flex-direction:column;gap:9rpx}.empty-account{border-style:dashed}.muted{color:#80918d;font-size:23rpx}.account-id{font-size:29rpx;font-weight:800;word-break:break-all}.tabs{display:flex;margin:28rpx 28rpx 23rpx;background:#e8ece7;padding:6rpx;border-radius:13rpx}.tab{flex:1;background:transparent;color:#71817d;border-radius:10rpx;font-size:25rpx;padding:14rpx 3rpx}.tab.active{background:#102d34;color:white}.section-heading{display:flex;align-items:center;justify-content:space-between;margin:0 28rpx 18rpx;font-size:31rpx;font-weight:800}.count{color:#ee735f;font-size:25rpx}.destination-card,.plan-card,.empty-card,.settings-card{margin:0 28rpx 18rpx;background:#fffdf9;border:1rpx solid #e5e5df;border-radius:18rpx;padding:25rpx;box-shadow:0 10rpx 30rpx rgba(22,49,54,.05)}.card-heading{display:flex;justify-content:space-between;align-items:center}.destination-name{display:block;font-size:31rpx;font-weight:800}.status{color:#ee735f;font-size:22rpx}.region{display:block;color:#82928e;font-size:23rpx;margin-top:8rpx}.tags{display:block;color:#6e9695;background:#e8f0ef;border-radius:20rpx;padding:8rpx 12rpx;font-size:21rpx;margin-top:18rpx}.info{display:flex;gap:14rpx;border-top:1rpx solid #ecebe5;padding-top:16rpx;margin-top:17rpx;color:#637a79;font-size:24rpx;line-height:1.5}.info-label{color:#ee735f;min-width:58rpx;font-weight:700}.note{color:#82928e}.empty-card{color:#82928e;text-align:center;padding:50rpx 25rpx}.plan-card{display:flex;gap:22rpx}.plan-date{width:125rpx;color:#ee735f;font-size:23rpx;display:flex;flex-direction:column;gap:9rpx}.plan-content{flex:1;display:flex;flex-direction:column;gap:9rpx;color:#82928e;font-size:24rpx;line-height:1.45}.plan-content .destination-name{color:#102d34}.plan-content .note{color:#82928e}.settings-card{display:flex;flex-direction:column;gap:14rpx;color:#617573;font-size:24rpx}.sync-summary{border-top:1rpx solid #ecebe5;padding-top:14rpx;line-height:1.5}.danger-button{margin:28rpx;background:transparent;border:1rpx solid #e28a7a;color:#c65448;border-radius:12rpx;font-size:26rpx}.footnote{display:block;color:#8b9b97;font-size:22rpx;line-height:1.6;margin:0 36rpx}
.markdown-note{display:block;flex:1;line-height:1.55}.markdown-note .markdown-line{display:block}.markdown-note .markdown-heading{display:block;font-weight:700;color:#102d34;margin-bottom:4rpx}.note{align-items:flex-start}
